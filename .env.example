# PostgreSQL (local dev)
DATABASE_URL=postgresql+asyncpg://postgres:admin123@localhost:5432/kickoff26

# Auth — passwords are bcrypt-hashed in the users table (never stored plaintext)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Fixture seed behavior: mock (skip re-seed if DB populated) | live (force re-seed on startup)
DATA_MODE=live

# Live scores: demo (simulated match, zero API calls) | api (API-Football poller + WebSocket fanout)
LIVE_DATA_MODE=demo

# API-Football via RapidAPI — required when LIVE_DATA_MODE=api
# Free tier: 100 requests/day, ~15s data delay, no webhooks (polling required)
# https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=

# Legacy alias (same as API_FOOTBALL_KEY)
RAPIDAPI_KEY=
RAPIDAPI_HOST=v3.football.api-sports.io

# football-data.org: optional one-shot score merge at startup
FOOTBALL_DATA_API_KEY=

CACHE_TTL_TEAMS=86400
CACHE_TTL_MATCHES=300
CACHE_TTL_STANDINGS=600

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
