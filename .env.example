# PostgreSQL (local dev)
DATABASE_URL=postgresql+asyncpg://postgres:<pwd>@localhost:5432/kickoff26

# Auth — passwords are bcrypt-hashed in the users table (never stored plaintext)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Fixture seed behavior: mock (skip re-seed if DB populated) | live (force re-seed on startup)
DATA_MODE=live

# Live scores: demo (simulated match, zero API calls) | api (rezarahiminia poller + WebSocket fanout)
LIVE_DATA_MODE=demo

# rezarahiminia World Cup 2026 API — required when LIVE_DATA_MODE=api
# Get a token (valid ~84 days): python scripts/get_worldcup_token.py --register --email .. --password ..
# Repo: https://github.com/rezarahiminia/worldcup2026  ·  Host: https://worldcup26.ir
WORLDCUP_API_TOKEN=
WORLDCUP_API_BASE=https://worldcup26.ir
# Live poller cadence (single shared backend poller; clients use WebSocket only)
WORLDCUP_POLL_LIVE_SECONDS=25
WORLDCUP_POLL_PRE_KICKOFF_SECONDS=30
WORLDCUP_POLL_IDLE_MAX_SECONDS=300
# Optional — only used by scripts/get_worldcup_token.py to register/authenticate
WORLDCUP_API_EMAIL=
WORLDCUP_API_PASSWORD=

# Zafronix squad rosters (Teams & Stats) - https://api.zafronix.com
# Auth: X-API-Key header (not Bearer). Sign up at https://api.zafronix.com/signup
ZAFRONIX_API_KEY=
ZAFRONIX_API_BASE=https://api.zafronix.com

# Legacy API-Football integration
API_FOOTBALL_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=v3.football.api-sports.io

# football-data.org: optional one-shot score merge at startup
FOOTBALL_DATA_API_KEY=

CACHE_TTL_TEAMS=86400
CACHE_TTL_MATCHES=300
CACHE_TTL_STANDINGS=600

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
