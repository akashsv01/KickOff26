# KickOff26 - environment template
# Copy to .env and fill in values:  cp .env.example .env
# Production values (Neon DB, DigitalOcean/Vercel URLs, wss://) belong in the
# hosting dashboards - do NOT commit real secrets to this file.

# === Database ===
# Local:      a local Postgres instance (see scripts/setup-postgres.ps1)
# Production: Neon Postgres pooled connection string (sslmode=require is handled
#             automatically; a postgres:// URL is normalized to asyncpg).
# If DATABASE_URL is unset, the backend falls back to a local SQLite file
# (backend/kickoff26.db) - handy for a quick spin-up; Postgres is recommended.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kickoff26
# Production example:
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# === Live data (rezarahiminia World Cup 2026 API) ===
# LIVE_DATA_MODE: api = real poller + WebSocket fan-out | demo = one simulated match, zero API calls
LIVE_DATA_MODE=demo
# Bearer token (valid ~84 days); required when LIVE_DATA_MODE=api.
# Get one: python scripts/get_worldcup_token.py --register --email .. --password ..
WORLDCUP_API_TOKEN=your_token_here
WORLDCUP_API_BASE=https://worldcup26.ir
# Live poller cadence (single shared backend poller; clients use WebSocket only)
WORLDCUP_POLL_LIVE_SECONDS=25
WORLDCUP_POLL_PRE_KICKOFF_SECONDS=30
WORLDCUP_POLL_IDLE_MAX_SECONDS=300
# Optional - only used by scripts/get_worldcup_token.py to register/authenticate
WORLDCUP_API_EMAIL=
WORLDCUP_API_PASSWORD=

# === Squads (Zafronix) ===
# Squads are fetched once and bundled as static JSON (backend/data/team_rosters_2026.json);
# no live polling by default (free tier = 250 req/day). Key kept only for an
# optional manual roster refresh.
ZAFRONIX_API_KEY=your_key_here
ZAFRONIX_API_BASE=https://api.zafronix.com
# Set true only to allow live Zafronix HTTP fetches (default false)
ZAFRONIX_LIVE_FETCH_ENABLED=false

# === AI assistant (Groq, free tier - https://console.groq.com) ===
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024

# === Auth ===
# Passwords are bcrypt-hashed in the users table (never stored plaintext).
JWT_SECRET=your_generated_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# === Data seeding ===
# mock = skip re-seed if DB already populated | live = force re-seed on startup
DATA_MODE=mock

# === CORS (comma-separated allowed origins) ===
# Local default below; add your production frontend origins in the host dashboard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kickoff2026.tech,https://www.kickoff2026.tech,https://kick-off26.vercel.app

# === Frontend ===
# Local:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Production (set in Vercel, do not commit real values):
#   NEXT_PUBLIC_API_URL=https://kickoff26-backend-vknuo.ondigitalocean.app
#   NEXT_PUBLIC_WS_URL=wss://kickoff26-backend-vknuo.ondigitalocean.app/ws

# === Cache TTLs (seconds) ===
CACHE_TTL_TEAMS=86400
CACHE_TTL_MATCHES=300
CACHE_TTL_STANDINGS=600
